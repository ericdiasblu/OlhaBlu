# Compose de produção. Não é necessário preencher para iniciar sem Docker.
DOMAIN=seu-fqdn.cloudapp.azure.com
ACME_EMAIL=seu-email@example.com
API_IMAGE=aex-api
WEB_IMAGE=aex-web
IMAGE_TAG=dev
DB_NAME=ocorrencias
DB_USER=ocorrencias
DB_PASSWORD=preencha-uma-senha-local
DB_ROOT_PASSWORD=preencha-outra-senha
# Público e incorporado no build do frontend. Nunca coloque segredos em VITE_*.
VITE_MAPBOX_TOKEN=
