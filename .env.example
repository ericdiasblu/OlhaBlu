# Compose local. Para HTTPS público, veja a seção de infraestrutura no README.
DOMAIN=
ACME_EMAIL=
WEB_BIND_IP=127.0.0.1
WEB_HTTP_PORT=8080
WEB_HTTPS_PORT=8443
API_IMAGE=aex-api
WEB_IMAGE=aex-web
IMAGE_TAG=dev
DB_NAME=ocorrencias
DB_USER=ocorrencias
DB_PASSWORD=preencha-uma-senha-local
DB_ROOT_PASSWORD=preencha-outra-senha
# Público e incorporado no build do frontend. Nunca coloque segredos em VITE_*.
VITE_MAPBOX_TOKEN=
# Administrador principal (se vazio, usa o ACME_EMAIL).
ADMIN_EMAIL=
# E-mails extras (separados por vírgula) que recebem perfil de moderação ao criar/entrar na conta.
MODERATOR_EMAILS=
